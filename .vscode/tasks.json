{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🌍 在浏览器中打开网页",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "start ${workspaceFolder}\\index.html"],
      "windows": {
        "command": "cmd",
        "args": ["/c", "start ${workspaceFolder}\\index.html"]
      },
      "inAgents": true,
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "🚀 启动本地 Web 服务器 (8000 端口)",
      "type": "shell",
      "command": "py",
      "args": ["-m", "http.server", "8000", "--directory", "${workspaceFolder}"],
      "windows": {
        "command": "py",
        "args": ["-m", "http.server", "8000", "--directory", "${workspaceFolder}"]
      },
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
